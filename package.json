{
  "name": "openboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p worker && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "preview:worker": "npm run build && wrangler dev",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
