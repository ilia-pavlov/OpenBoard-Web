{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openboard-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    // `npm run build` output. Static files are served directly; the Worker
    // only runs for the US Chess relay paths.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The page itself runs the Worker too, so www and the old workers.dev
    // address can be redirected to the canonical host; /p/, /e/ and /t/ are
    // share links that get link-preview tags.
    "run_worker_first": ["/api/*", "/", "/index.html", "/p/*", "/e/*", "/t/*"]
  },
  "vars": {
    "CANONICAL_HOST": "openboard.online"
  },
  // Keep the old workers.dev address alive so its links forward to openboard.online
  // (Wrangler turns it off by default once custom domains are listed).
  "workers_dev": true,
  // Preview URLs (`npm run preview:upload`) let a version be tried, e.g. on a
  // phone's Home Screen, before it is deployed to openboard.online.
  "preview_urls": true,
  "routes": [
    { "pattern": "openboard.online", "custom_domain": true },
    { "pattern": "www.openboard.online", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
